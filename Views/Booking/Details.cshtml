@model dynamic 

@{
    var exchangeRate = 0.000041M; // Exchange rate as decimal
    var pricePerNightUSD = Model.Booking.Room.Price * exchangeRate; // Calculate price per night
    var totalExpectedPriceUSD = pricePerNightUSD * (decimal)Model.Booking.TotalNights; // Total expected price
    var priceDiscount = Model.Booking.Price; // Discounted price
    var savedAmountUSD = totalExpectedPriceUSD - priceDiscount; // Calculate saved amount
}
<!-- Style -->
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<link rel="stylesheet" href="css/style.css">
